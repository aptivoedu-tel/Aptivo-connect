# Aptivo Connect — Required Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aptivo_connect?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────────────────────
# Session Security
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=<at_least_32_random_characters>

# ─────────────────────────────────────────────────────────────────────────────
# Ably Realtime
# ─────────────────────────────────────────────────────────────────────────────
ABLY_API_KEY=<ably_api_key>

# ─────────────────────────────────────────────────────────────────────────────
# Admin Bootstrap
# Used only when POST /api/seed or /api/admin/clean-dummy-data is called.
# Sets (or resets) the password for admin@connect.aptivo.
# Must be at least 8 characters. Change this to your secure admin password.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_BOOTSTRAP_PASSWORD=<secure_admin_password_min_8_chars>

# ─────────────────────────────────────────────────────────────────────────────
# Public App Metadata
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Aptivo Connect"
NEXT_PUBLIC_APP_TAGLINE="Meet. Build. Experience."
