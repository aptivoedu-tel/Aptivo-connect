# Required server-side services
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/aptivo
# Generate a unique random value of at least 32 characters; never commit the real value.
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
# Server-only Ably key. Create it in Ably and set it in Vercel as an encrypted environment variable.
ABLY_API_KEY=replace-with-your-ably-api-key
