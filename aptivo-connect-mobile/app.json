{
  "expo": {
    "name": "Aptivo Connect",
    "slug": "aptivo-connect-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "aptivo-connect",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aptivo.connect.dev"
    },
    "android": {
      "package": "com.aptivo.connect.dev",
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router", "expo-secure-store", ["expo-notifications", { "color": "#174D3A", "defaultChannel": "aptivo-activity" }]]
  }
}
